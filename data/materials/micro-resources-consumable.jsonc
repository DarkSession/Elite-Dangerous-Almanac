/*
 * Odyssey micro resources — the consumable category.
 *
 * Consumables — the deployable field tools (medkits, energy cells, grenades, E-Breach) carried on foot.
 *
 * Source: EDCD FDevIDs, microresources.csv.
 *
 * Credit and licence terms: ATTRIBUTIONS.md. Acquisition, revisions, derivation and
 * corrections: data/materials/SOURCES.md.
 *
 * Each record is { symbol, name }. `symbol` is Frontier's internal id
 * (e.g. `graphene`) — what the player journal reports, matched case-insensitively;
 * `name` is the display name. The file determines the `consumable` category, so it is
 * not repeated on every record. Frontier's numeric micro-resource id is not carried.
 */
[
  {
    "symbol": "healthpack",
    "name": "Medkit"
  },
  {
    "symbol": "energycell",
    "name": "Energy Cell"
  },
  {
    "symbol": "amm_grenade_emp",
    "name": "Shield Disruptor"
  },
  {
    "symbol": "amm_grenade_frag",
    "name": "Frag Grenade"
  },
  {
    "symbol": "amm_grenade_shield",
    "name": "Shield Projector"
  },
  {
    "symbol": "bypass",
    "name": "E-Breach"
  }
]
