/*
 * The galaxy map's location markers and the colours the game draws them in.
 *
 * Source: the in-game galaxy map. Each colour is measured from a capture of the
 * marker, and is the colour the matching `assets/galaxy-map/<symbol>.svg` paints with.
 *
 * Credit and licence terms: ATTRIBUTIONS.md. Acquisition, derivation and
 * corrections: data/galaxy-map/SOURCES.md.
 *
 * `symbol` names the marker and the asset file. `color` is the glyph colour.
 * `frameColor` is the square border's colour, which matches `color` on every
 * marker but `front-line`.
 */
[
  { "symbol": "bookmark", "color": "#FF2800", "frameColor": "#FF2800" },
  { "symbol": "community-goal", "color": "#FF9A00", "frameColor": "#FF9A00" },
  { "symbol": "conflict-zone", "color": "#FFAE00", "frameColor": "#FFAE00" },
  { "symbol": "destination", "color": "#FF2800", "frameColor": "#FF2800" },
  { "symbol": "engineer", "color": "#FF2800", "frameColor": "#FF2800" },
  { "symbol": "fleet-carrier", "color": "#FF2800", "frameColor": "#FF2800" },
  { "symbol": "front-line", "color": "#9418FF", "frameColor": "#4A00B5" },
  { "symbol": "mission", "color": "#005DFF", "frameColor": "#005DFF" },
  { "symbol": "squadron-carrier", "color": "#63FFF7", "frameColor": "#63FFF7" },
  { "symbol": "starter-zone", "color": "#FF2800", "frameColor": "#FF2800" },
  { "symbol": "station-abandoned", "color": "#211C21", "frameColor": "#211C21" },
  { "symbol": "station-damaged", "color": "#FF3400", "frameColor": "#FF3400" },
  { "symbol": "station-repairing", "color": "#FF9210", "frameColor": "#FF9210" },
  { "symbol": "station-under-attack", "color": "#FF0000", "frameColor": "#FF0000" },
  { "symbol": "titan", "color": "#FF0000", "frameColor": "#FF0000" },
  { "symbol": "waypoint", "color": "#FF2800", "frameColor": "#FF2800" }
]
