<Project>

  <!--
    Settings every project in the .NET port shares. RepositoryRoot points at the
    shared, language-neutral assets (data/, fixtures/, assets/); no project copies
    them into dotnet/.
  -->
  <PropertyGroup>
    <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</RepositoryRoot>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!--
    Every project keeps a packages.lock.json beside it. CI restores in locked mode,
    which fails rather than resolving when the lock file and the project files
    disagree. It is the same guarantee the frozen lockfile gives the TypeScript
    package.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
