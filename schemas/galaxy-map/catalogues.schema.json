{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elite-dangerous-almanac.dev/schemas/galaxy-map/catalogues.schema.json",
  "title": "Elite Dangerous Almanac galaxy-map catalogue schemas",
  "description": "Language-neutral schemas for every JSONC payload in data/galaxy-map.",
  "definitions": {
    "markerSymbol": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$"
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "color", "frameColor"],
      "properties": {
        "symbol": { "$ref": "#/definitions/markerSymbol" },
        "color": { "$ref": "#/definitions/hexColor" },
        "frameColor": { "$ref": "#/definitions/hexColor" }
      }
    },
    "markerCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/marker" }
    }
  }
}
