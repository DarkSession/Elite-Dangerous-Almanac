{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elite-dangerous-almanac.dev/schemas/materials/catalogues.schema.json",
  "title": "Elite Dangerous Almanac material catalogue schemas",
  "description": "Language-neutral schemas for every JSONC payload in data/materials.",
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "elementSymbol", "grade", "line"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "elementSymbol": {
          "type": ["string", "null"]
        },
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "line": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "rawMaterialCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/material" },
          {
            "properties": {
              "elementSymbol": { "$ref": "#/definitions/nonEmptyString" },
              "grade": { "maximum": 4 },
              "line": {
                "enum": [
                  "Carbon",
                  "Phosphorus",
                  "Sulphur",
                  "Iron",
                  "Nickel",
                  "Rhenium",
                  "Lead"
                ]
              }
            }
          }
        ]
      }
    },
    "manufacturedMaterialCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/material" },
          {
            "properties": {
              "elementSymbol": { "type": "null" },
              "line": {
                "enum": [
                  "Chemical",
                  "Thermic",
                  "Heat",
                  "Conductive",
                  "Mechanical Components",
                  "Capacitors",
                  "Shielding",
                  "Composite",
                  "Crystals",
                  "Alloys",
                  "Guardian",
                  "Thargoid"
                ]
              }
            }
          }
        ]
      }
    },
    "encodedMaterialCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/material" },
          {
            "properties": {
              "elementSymbol": { "type": "null" },
              "line": {
                "enum": [
                  "Emission Data",
                  "Wake Scans",
                  "Shield Data",
                  "Encryption Files",
                  "Data Archives",
                  "Encoded Firmware",
                  "Guardian",
                  "Thargoid"
                ]
              }
            }
          }
        ]
      }
    },
    "microResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "componentMicroResourceCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/microResource" }
    },
    "consumableMicroResourceCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/microResource" }
    },
    "dataMicroResourceCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/microResource" }
    },
    "itemMicroResourceCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/microResource" }
    }
  }
}
