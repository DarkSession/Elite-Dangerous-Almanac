{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elite-dangerous-almanac.dev/schemas/ships/catalogues.schema.json",
  "title": "Elite Dangerous Almanac ship catalogue schemas",
  "description": "Language-neutral schemas for every JSONC payload in data/ships.",
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "coreSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powerPlant",
        "thrusters",
        "frameShiftDrive",
        "lifeSupport",
        "powerDistributor",
        "sensors",
        "fuelTank"
      ],
      "properties": {
        "powerPlant": { "type": "integer", "minimum": 1, "maximum": 8 },
        "thrusters": { "type": "integer", "minimum": 1, "maximum": 8 },
        "frameShiftDrive": { "type": "integer", "minimum": 1, "maximum": 8 },
        "lifeSupport": { "type": "integer", "minimum": 1, "maximum": 8 },
        "powerDistributor": { "type": "integer", "minimum": 1, "maximum": 8 },
        "sensors": { "type": "integer", "minimum": 1, "maximum": 8 },
        "fuelTank": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "hardpointSlot": {
      "description": "One weapon hardpoint: its size, plus a restriction when the mount only takes one family of modules (the Type-11 Prospector's mining mounts).",
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "type": "integer", "minimum": 1, "maximum": 4 },
        "restriction": {
          "enum": ["mining"]
        },
        "name": {
          "description": "The mount's journal slot key, when the ordinary numbering rules do not reproduce it (the Anaconda's Slot13_Size2, the Type-9 Heavy's Slot00_Size8, the Caspian Explorer's out-of-order mediums, the Keelback's Slot03_Size3). Absent when the rules are right. A _SizeN suffix is the game's own and may disagree with this mount's `size`, which is always the real one.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "optionalSlot": {
      "description": "One optional-internal mount: its size, plus a restriction when the mount only takes one family of modules.",
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": { "type": "integer", "minimum": 1, "maximum": 8 },
        "restriction": {
          "enum": [
            "military",
            "planetaryApproachSuite",
            "cargo",
            "limpetController",
            "vesselHangar",
            "passenger"
          ]
        },
        "name": {
          "description": "The mount's journal slot key, when the ordinary numbering rules do not reproduce it (the Anaconda's Slot13_Size2, the Type-9 Heavy's Slot00_Size8, the Caspian Explorer's out-of-order mediums, the Keelback's Slot03_Size3). Absent when the rules are right. A _SizeN suffix is the game's own and may disagree with this mount's `size`, which is always the real one.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resistance": {
      "description": "Fraction of incoming damage of one type removed; negative is a weakness.",
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "damageDistribution": {
      "description": "How a weapon's conventional damage splits by type. The conventional shares sum to 1; antiXeno overlays them rather than partitioning and may exceed 1.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "kinetic": { "type": "number", "minimum": 0, "maximum": 1 },
        "thermal": { "type": "number", "minimum": 0, "maximum": 1 },
        "explosive": { "type": "number", "minimum": 0, "maximum": 1 },
        "absolute": { "type": "number", "minimum": 0, "maximum": 1 },
        "unclassified": { "type": "number", "minimum": 0, "maximum": 1 },
        "antiXeno": { "type": "number", "minimum": 0 }
      }
    },
    "damageComponents": {
      "description": "Exact damage amounts per round, or per second for continuous fire.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "kinetic": { "type": "number", "minimum": 0 },
        "thermal": { "type": "number", "minimum": 0 },
        "explosive": { "type": "number", "minimum": 0 },
        "absolute": { "type": "number", "minimum": 0 },
        "antiXeno": { "type": "number", "minimum": 0 },
        "unclassified": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        }
      }
    },
    "projectileRange": {
      "description": "Projectile boundary parameters observed in-game; not effective distances.",
      "type": "object",
      "additionalProperties": false,
      "required": ["falloffBoundary"],
      "properties": {
        "maximumBoundary": { "type": "number", "minimum": 0 },
        "falloffBoundary": { "type": "number", "minimum": 0 }
      }
    },
    "ship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "entitlement": { "$ref": "#/definitions/nonEmptyString" },

        "hullCost": { "type": "integer", "minimum": 0 },
        "retailCost": { "type": "integer", "minimum": 0 },

        "hullMass": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "boost": { "type": "number", "minimum": 0 },
        "baseShieldStrength": { "type": "number", "minimum": 0 },
        "baseArmour": { "type": "number", "minimum": 0 },
        "hardness": { "type": "number", "minimum": 0 },
        "masslock": { "type": "number", "minimum": 0 },
        "crew": { "type": "integer", "minimum": 1 },
        "heatCapacity": { "type": "number", "minimum": 0 },
        "reserveFuelCapacity": { "type": "number", "minimum": 0 },
        "pitch": { "type": "number", "minimum": 0 },
        "roll": { "type": "number", "minimum": 0 },
        "yaw": { "type": "number", "minimum": 0 },
        "minThrust": { "type": "number", "minimum": 0, "maximum": 100 },
        "pipSpeed": { "type": "number", "minimum": 0 },

        "core": { "$ref": "#/definitions/coreSlots" },
        "hardpoints": {
          "type": "array",
          "items": { "$ref": "#/definitions/hardpointSlot" }
        },
        "utility": { "type": "integer", "minimum": 0 },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/definitions/optionalSlot" }
        }
      }
    },
    "shipCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ship" }
    },
    "module": {
      "description": "One outfitting module. The record carries no `category`: which of the four it is, is which modules-*.jsonc file it was read from, so a loader adds the category from the file rather than every record repeating it. The four `*ModuleCatalogue` definitions below say what each file additionally requires.",
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "class", "rating"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "slot": {
          "description": "The fixed mount this module fills: `armour` or one of the seven core functions. Required on every record in modules-core.jsonc; in modules-internal.jsonc it appears only on the Guardian Hybrid power plants and distributors, which Frontier files as internal modules yet which fill a core mount. Never present on a hardpoint or utility module.",
          "enum": [
            "armour",
            "powerPlant",
            "thrusters",
            "frameShiftDrive",
            "lifeSupport",
            "powerDistributor",
            "sensors",
            "fuelTank"
          ]
        },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "class": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "rating": {
          "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I"]
        },
        "mount": {
          "enum": ["Fixed", "Gimballed", "Turreted"]
        },
        "guidance": {
          "enum": ["Dumbfire", "Seeker", "Swarm"]
        },
        "ship": { "$ref": "#/definitions/nonEmptyString" },
        "entitlement": { "$ref": "#/definitions/nonEmptyString" },

        "restrictedToShips": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "restrictedToSlot": {
          "description": "The slot restriction this module requires: it fits only mounts carrying it, and no unrestricted mount. The mirror of a mount's `restriction`, for the modules the game sells for one kind of mount alone — the planetary approach suites, the Mk II Cargo Racks and the Mk II Mining Multi-Limpet Controller.",
          "enum": [
            "mining",
            "military",
            "planetaryApproachSuite",
            "cargo",
            "limpetController",
            "vesselHangar",
            "passenger"
          ]
        },
        "mass": { "type": "number", "minimum": 0 },
        "integrity": { "type": "number", "minimum": 0 },
        "powerDraw": { "type": "number", "minimum": 0 },
        "bootTime": { "type": "number", "minimum": 0 },
        "optMass": { "type": "number", "minimum": 0 },
        "minMass": { "type": "number", "minimum": 0 },
        "maxMass": { "type": "number", "minimum": 0 },
        "optMultiplier": { "type": "number" },
        "minMultiplier": { "type": "number" },
        "maxMultiplier": { "type": "number" },
        "engineHeatRate": { "type": "number", "minimum": 0 },
        "maxFuel": { "type": "number", "minimum": 0 },
        "fuelMul": { "type": "number", "exclusiveMinimum": 0 },
        "fuelPower": { "type": "number", "exclusiveMinimum": 0 },
        "fsdHeatRate": { "type": "number", "minimum": 0 },
        "jumpBoost": { "type": "number", "minimum": 0 },
        "powerCapacity": { "type": "number", "minimum": 0 },
        "heatEfficiency": { "type": "number", "minimum": 0 },
        "weaponsCapacity": { "type": "number", "minimum": 0 },
        "weaponsRecharge": { "type": "number", "minimum": 0 },
        "enginesCapacity": { "type": "number", "minimum": 0 },
        "enginesRecharge": { "type": "number", "minimum": 0 },
        "systemsCapacity": { "type": "number", "minimum": 0 },
        "systemsRecharge": { "type": "number", "minimum": 0 },
        "refuelRate": { "type": "number", "minimum": 0 },
        "fuelCapacity": { "type": "number", "minimum": 0 },
        "cargoCapacity": { "type": "number", "minimum": 0 },
        "shieldRegenRate": { "type": "number", "minimum": 0 },
        "shieldBrokenRegenRate": { "type": "number", "minimum": 0 },
        "shieldBoost": { "type": "number" },

        "shieldBankReinforcement": { "type": "number", "minimum": 0 },
        "shieldBankHeat": { "type": "number", "minimum": 0 },
        "shieldBankSpinUp": { "type": "number", "minimum": 0 },
        "shieldBankDuration": { "type": "number", "minimum": 0 },

        "kineticResistance": { "$ref": "#/definitions/resistance" },
        "thermalResistance": { "$ref": "#/definitions/resistance" },
        "explosiveResistance": { "$ref": "#/definitions/resistance" },
        "causticResistance": { "$ref": "#/definitions/resistance" },
        "hullBoost": { "type": "number", "minimum": 0 },
        "hullReinforcement": { "type": "number", "minimum": 0 },
        "shieldAddition": { "type": "number", "minimum": 0 },
        "moduleProtection": { "type": "number", "minimum": 0, "maximum": 1 },

        "scannerRange": { "type": "number", "minimum": 0 },
        "scanAngle": { "type": "number", "minimum": 0, "maximum": 360 },
        "scanTime": { "type": "number", "minimum": 0 },
        "probeRadius": { "type": "number", "minimum": 0 },

        "interdictorFacingLimit": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "interdictorRange": { "type": "number", "minimum": 0 },

        "alwaysPowered": { "type": "boolean" },

        "damage": { "type": "number", "minimum": 0 },
        "damageDistribution": { "$ref": "#/definitions/damageDistribution" },
        "damageComponents": { "$ref": "#/definitions/damageComponents" },
        "roundsPerShot": { "type": "number", "minimum": 1 },
        "rateOfFire": { "type": "number", "exclusiveMinimum": 0 },
        "burstInterval": { "type": "number", "exclusiveMinimum": 0 },
        "burstRounds": { "type": "number", "minimum": 1 },
        "burstRateOfFire": { "type": "number", "exclusiveMinimum": 0 },
        "chargeTime": { "type": "number", "minimum": 0 },
        "clipSize": { "type": "number", "minimum": 0 },
        "ammoMaximum": { "type": "number", "minimum": 0 },
        "reloadTime": { "type": "number", "minimum": 0 },
        "distributorDraw": { "type": "number", "minimum": 0 },
        "thermalLoad": { "type": "number", "minimum": 0 },
        "armourPiercing": { "type": "number", "minimum": 0 },
        "maximumRange": { "type": "number", "minimum": 0 },
        "falloffRange": { "type": "number", "minimum": 0 },
        "projectileRange": { "$ref": "#/definitions/projectileRange" },
        "shotSpeed": { "type": "number", "minimum": 0 },
        "jitter": { "type": "number", "minimum": 0 },

        "cost": { "type": "integer", "minimum": 0 }
      }
    },
    "coreModuleCatalogue": {
      "description": "modules-core.jsonc — every record fills one of the eight core mounts and says which in `slot`.",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/module" },
          { "required": ["slot"] },
          {
            "description": "And `slot` names the mount that module actually fills. Requiring the field only would let an FSD claim `sensors`; pairing each symbol family with its mount is what makes this file the contract rather than the code that reads it.",
            "oneOf": [
              {
                "properties": {
                  "symbol": { "pattern": "_Armour_" },
                  "slot": { "const": "armour" }
                }
              },
              {
                "properties": {
                  "symbol": { "pattern": "^Int_Power[Pp]lant_" },
                  "slot": { "const": "powerPlant" }
                }
              },
              {
                "properties": {
                  "symbol": {
                    "pattern": "^Int_(?:Engine|MkIIAgileBoost_Engine)_"
                  },
                  "slot": { "const": "thrusters" }
                }
              },
              {
                "properties": {
                  "symbol": { "pattern": "^Int_Hyperdrive_" },
                  "slot": { "const": "frameShiftDrive" }
                }
              },
              {
                "properties": {
                  "symbol": { "pattern": "^Int_LifeSupport_" },
                  "slot": { "const": "lifeSupport" }
                }
              },
              {
                "properties": {
                  "symbol": { "pattern": "^Int_PowerDistributor_" },
                  "slot": { "const": "powerDistributor" }
                }
              },
              {
                "properties": {
                  "symbol": { "pattern": "^Int_Sensors_" },
                  "slot": { "const": "sensors" }
                }
              },
              {
                "properties": {
                  "symbol": { "pattern": "^Int_FuelTank_" },
                  "slot": { "const": "fuelTank" }
                }
              }
            ]
          }
        ]
      }
    },
    "internalModuleCatalogue": {
      "description": "modules-internal.jsonc — an optional internal fits any optional mount its size and carries no `slot`; the Guardian Hybrid power plants and distributors carry one because they fill a core mount instead.",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/module" },
          {
            "if": { "required": ["slot"] },
            "then": {
              "description": "A `slot` here belongs to a Guardian Hybrid, and names the mount that hybrid actually fills — matching the symbol alone would let one claim any of the eight.",
              "oneOf": [
                {
                  "properties": {
                    "symbol": { "pattern": "^Int_GuardianPower[Pp]lant_" },
                    "slot": { "const": "powerPlant" }
                  }
                },
                {
                  "properties": {
                    "symbol": { "pattern": "^Int_GuardianPowerDistributor_" },
                    "slot": { "const": "powerDistributor" }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "hardpointModuleCatalogue": {
      "description": "modules-hardpoint.jsonc — a weapon mount is not a fixed mount, so no record carries `slot`.",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/module" },
          { "not": { "required": ["slot"] } }
        ]
      }
    },
    "utilityModuleCatalogue": {
      "description": "modules-utility.jsonc — a utility mount is not a fixed mount, so no record carries `slot`.",
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/definitions/module" },
          { "not": { "required": ["slot"] } }
        ]
      }
    },
    "blueprintFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "method", "min", "max"],
      "properties": {
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "method": {
          "enum": ["multiplicative", "additive", "overwrite"]
        },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "blueprintMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "count"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "blueprintGrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "materials"],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/blueprintFeature" }
        },
        "damageDistribution": { "$ref": "#/definitions/damageDistribution" },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/definitions/blueprintMaterial" }
        }
      }
    },
    "blueprintGrades": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[1-5]$": { "$ref": "#/definitions/blueprintGrade" }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "grades"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "journalName": {
          "description": "The `BlueprintName` a journal writes for this recipe, when that is not the key it is stored under. Present only where the game spells one id for two different recipes, which the fitted module disambiguates.",
          "type": "string",
          "minLength": 1
        },
        "grades": { "$ref": "#/definitions/blueprintGrades" }
      }
    },
    "blueprintCatalogue": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/blueprint"
      }
    },
    "experimentalContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "method", "value"],
      "properties": {
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "method": {
          "enum": ["multiplicative", "additive", "overwrite"]
        },
        "value": { "type": "number" }
      }
    },
    "experimentalEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "modifiers", "materials"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "modifiers": {
          "type": "array",
          "items": { "$ref": "#/definitions/experimentalContribution" }
        },
        "damageDistribution": { "$ref": "#/definitions/damageDistribution" },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/definitions/blueprintMaterial" }
        },
        "description": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "experimentalCatalogue": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/experimentalEffect"
      }
    },
    "preEngineeredModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "method", "value"],
      "properties": {
        "label": { "$ref": "#/definitions/nonEmptyString" },
        "method": { "enum": ["multiplicative", "additive", "overwrite"] },
        "value": { "type": "number" }
      }
    },
    "preEngineeredVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "blueprint", "grade", "acquisition"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "blueprint": { "$ref": "#/definitions/nonEmptyString" },
        "grade": { "type": "integer", "minimum": 1, "maximum": 5 },
        "experimental": { "$ref": "#/definitions/nonEmptyString" },
        "acquisition": { "enum": ["mercenary", "communityGoal", "techBroker"] },
        "mercCoinCost": { "type": "integer", "exclusiveMinimum": 0 },
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/preEngineeredModifier" }
        }
      }
    },
    "preEngineeredCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/preEngineeredVariant" }
    },
    "engineeringOptionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "blueprints", "experimentals"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "blueprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "experimentals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "engineeringOptionCatalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "modules", "exclusions"],
      "properties": {
        "groups": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/engineeringOptionGroup"
          }
        },
        "modules": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/nonEmptyString" }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/nonEmptyString" }
          }
        }
      }
    },
    "decorativeModification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "modules", "modifiers"],
      "properties": {
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        },
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/preEngineeredModifier" }
        }
      }
    },
    "decorativeCatalogue": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/decorativeModification"
      }
    }
  }
}
