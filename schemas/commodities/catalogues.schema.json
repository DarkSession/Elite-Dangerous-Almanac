{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elite-dangerous-almanac.dev/schemas/commodities/catalogues.schema.json",
  "title": "Elite Dangerous Almanac commodity catalogue schemas",
  "description": "Language-neutral schemas for every JSONC payload in data/commodities.",
  "definitions": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "commodity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "name", "category"],
      "properties": {
        "symbol": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "$ref": "#/definitions/nonEmptyString" },
        "category": {
          "enum": [
            "Chemicals",
            "Consumer Items",
            "Foods",
            "Industrial Materials",
            "Legal Drugs",
            "Machinery",
            "Medicines",
            "Metals",
            "Minerals",
            "NonMarketable",
            "Salvage",
            "Slavery",
            "Technology",
            "Textiles",
            "Waste",
            "Weapons"
          ]
        }
      }
    },
    "commodityCatalogue": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/commodity" }
    }
  }
}
