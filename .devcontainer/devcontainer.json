{
  "name": "Elite Dangerous Almanac",
  "build": {
    "dockerfile": "Dockerfile"
  },

  "runArgs": ["--privileged"],

  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12",
      "installTools": true
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Persist Claude Code auth/config from the host into the container
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/home/node/.claude,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json,target=/home/node/.claude.json,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code",
        "openai.chatgpt"
      ]
    }
  },

  "remoteUser": "node",
  // pnpm comes from the image (see Dockerfile), not from here: enabling Corepack as
  // this user cannot write the shim. `pnpm --version` resolves the pin in
  // typescript/package.json, so it reports the version the container will actually use.
  // Ponytail is pinned to the v4.9.0 commit so container creation never executes a
  // moving third-party ref.
  "postCreateCommand": "node --version && python3 --version && cd typescript && pnpm --version && codex plugin marketplace add DietrichGebert/ponytail --ref 0a4dd63ad4541f4f655c4108a295916f3c1d8fda && codex plugin add ponytail@ponytail"
}
