{
    "name": "@elite-dangerous-almanac/core",
    "version": "0.0.1",
    "description": "Ready-to-go static data and calculations for Elite Dangerous community apps and researchers.",
    "type": "module",
    "sideEffects": false,
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DarkSession/Elite-Dangerous-Almanac.git",
        "directory": "typescript"
    },
    "homepage": "https://github.com/DarkSession/Elite-Dangerous-Almanac#readme",
    "bugs": {
        "url": "https://github.com/DarkSession/Elite-Dangerous-Almanac/issues"
    },
    "keywords": [
        "elite-dangerous",
        "astronomy",
        "ships",
        "engineering",
        "game-data"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./astro": {
            "types": "./dist/astro/index.d.ts",
            "import": "./dist/astro/index.js"
        },
        "./astro/*": {
            "types": "./dist/astro/*.d.ts",
            "import": "./dist/astro/*.js"
        },
        "./commodities/commodity-catalogue": null,
        "./commodities": {
            "types": "./dist/commodities/index.d.ts",
            "import": "./dist/commodities/index.js"
        },
        "./commodities/*": {
            "types": "./dist/commodities/*.d.ts",
            "import": "./dist/commodities/*.js"
        },
        "./materials/material-catalogue": null,
        "./materials": {
            "types": "./dist/materials/index.d.ts",
            "import": "./dist/materials/index.js"
        },
        "./materials/*": {
            "types": "./dist/materials/*.d.ts",
            "import": "./dist/materials/*.js"
        },
        "./ships": {
            "types": "./dist/ships/index.d.ts",
            "import": "./dist/ships/index.js"
        },
        "./ships/engineering-compatibility": null,
        "./ships/*": {
            "types": "./dist/ships/*.d.ts",
            "import": "./dist/ships/*.js"
        }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "build": "tsup",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
        "format": "prettier --write . ../README.md ../schemas/**/*.{json,md} ../.github/workflows/*.yml",
        "format:check": "prettier --check . ../README.md ../schemas/**/*.{json,md} ../.github/workflows/*.yml",
        "lint": "eslint .",
        "prepublishOnly": "npm run check && npm run build && npm run test:package",
        "test": "node --experimental-test-coverage --test-coverage-include=\"src/astro/*.ts\" --test-coverage-include=\"src/materials/*.ts\" --test-coverage-include=\"src/ships/*.ts\" --test-coverage-include=\"src/commodities/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --import tsx --import ./scripts/register-jsonc.mjs --test \"src/**/*.test.ts\"",
        "typecheck": "tsc --noEmit",
        "docs": "typedoc && node scripts/postprocess-wiki.mjs",
        "test:package": "node --test package.test.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.1",
        "ajv": "^6.15.0",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "tsx": "^4.19.2",
        "typedoc": "^0.28.1",
        "typedoc-github-wiki-theme": "^2.1.0",
        "typedoc-plugin-markdown": "^4.4.1",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.65.0"
    }
}
