    "scripts": {
        "audit": "npm audit --audit-level=low",
        "build": "node scripts/copy-notices.mjs && tsup && node scripts/prune-sourcemap-sources.mjs && node scripts/prune-barrel-imports.mjs && node scripts/attach-barrel-docs.mjs",
        "check": "npm run check:fixtures && npm run lint && npm run format:check && npm run typecheck && npm run check:examples && npm test",
        "check:fixtures": "node ../scripts/fixtures/generate-schema-and-types.mjs --check",
        "format": "prettier --write . ../README.md ../CONTRIBUTING.md ../SECURITY.md ../schemas/**/*.{json,md} ../scripts/**/*.mjs ../.github/*.{md,yml} ../.github/workflows/*.yml ../.github/ISSUE_TEMPLATE/*.yml",
        "format:check": "prettier --check . ../README.md ../CONTRIBUTING.md ../SECURITY.md ../schemas/**/*.{json,md} ../scripts/**/*.mjs ../.github/*.{md,yml} ../.github/workflows/*.yml ../.github/ISSUE_TEMPLATE/*.yml",
        "generate:fixtures": "node ../scripts/fixtures/generate-schema-and-types.mjs",
        "lint": "eslint .",
        "prepublishOnly": "npm run check && npm run build && npm run test:package",
        "test": "node --experimental-test-coverage --test-coverage-include=\"src/internal/**/*.ts\" --test-coverage-include=\"src/astro/**/*.ts\" --test-coverage-include=\"src/materials/**/*.ts\" --test-coverage-include=\"src/ships/**/*.ts\" --test-coverage-include=\"src/commodities/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --import tsx --import ./scripts/register-jsonc.mjs --test \"src/**/*.test.ts\"",
        "typecheck": "tsc --noEmit",
        "docs": "typedoc && node scripts/build-wiki-sidebar.mjs && node scripts/postprocess-wiki.mjs",
        "check:examples": "node --test scripts/example-claims.test.mjs scripts/example-runtime.test.mjs && node scripts/check-examples.mjs --strict --min-executable-claims 259 --max-compile-only-claims 123",
        "test:package": "node --test package.test.mjs"
    },
    "overrides": {
        "brace-expansion": "5.0.9",
        "esbuild": "0.28.1"
    },
