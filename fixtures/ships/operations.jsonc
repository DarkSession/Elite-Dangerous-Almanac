/*
 * Shared test fixture — not shipped in any package.
 *
 * Cross-language parity cases for loaded mobility, shield recovery, distributor
 * recharge, WEP-capacitor endurance, shield-cell pools, one-per-ship and
 * counted-module validation, direct retail and Merc Coin pricing, alpha-strike thermal
 * load, import rejections, structured diagnostics and editor failures. Inputs pin the
 * public data-free and ShipLoadout facade contracts; catalogue-backed expectations pin
 * the shared ship and module snapshots.
 */
{
  "mobility": {
    "input": {
      "minimumSpeed": 80,
      "maximumSpeed": 200,
      "boost": 300,
      "minPitch": 16,
      "pitch": 40,
      "minRoll": 40,
      "roll": 100,
      "minYaw": 8,
      "yaw": 20,
      "mass": 90,
      "thrusters": {
        "minMass": 70,
        "optMass": 90,
        "maxMass": 200,
        "minMultiplier": 0.9,
        "optMultiplier": 1.1,
        "maxMultiplier": 1.2,
        "speedCurve": {
          "minMass": 70,
          "optMass": 90,
          "maxMass": 200,
          "minMultiplier": 0.9,
          "optMultiplier": 1.25,
          "maxMultiplier": 1.6
        },
        "rotationCurve": {
          "minMass": 70,
          "optMass": 90,
          "maxMass": 200,
          "minMultiplier": 0.9,
          "optMultiplier": 1.1,
          "maxMultiplier": 1.3
        }
      }
    },
    "expected": {
      "speed": 250,
      "boost": 375,
      "pitch": 44,
      "roll": 110,
      "yaw": 22,
      "massCurveMultiplier": 1.25,
      "rotationMassCurveMultiplier": 1.1
    },
    "zeroPipRotation": {
      "input": {
        "minimumSpeed": 210,
        "maximumSpeed": 285,
        "boost": 350,
        "minPitch": 23,
        "pitch": 26,
        "minRoll": 60,
        "roll": 60,
        "minYaw": 19,
        "yaw": 19,
        "mass": 100,
        "thrusters": {
          "minMass": 50,
          "optMass": 100,
          "maxMass": 200,
          "minMultiplier": 1,
          "optMultiplier": 1,
          "maxMultiplier": 1
        },
        "enginesPips": 0
      },
      "expected": {
        "speed": 210,
        "boost": 350,
        "pitch": 23,
        "roll": 60,
        "yaw": 19,
        "massCurveMultiplier": 1,
        "rotationMassCurveMultiplier": 1
      },
      "speedSequence": [210, 228.75, 247.5, 266.25, 285],
      "pitchSequence": [23, 23.75, 24.5, 25.25, 26]
    },
    "pipAllocation": {
      "input": {
        "minimumSpeed": 80,
        "maximumSpeed": 200,
        "boost": 300,
        "minPitch": 24,
        "pitch": 40,
        "minRoll": 60,
        "roll": 100,
        "minYaw": 12,
        "yaw": 20,
        "mass": 100,
        "thrusters": {
          "minMass": 50,
          "optMass": 100,
          "maxMass": 200,
          "minMultiplier": 1,
          "optMultiplier": 1,
          "maxMultiplier": 1
        },
        "enginesPips": 2
      },
      "expected": {
        "speed": 140,
        "boost": 300,
        "pitch": 32,
        "roll": 80,
        "yaw": 16,
        "massCurveMultiplier": 1,
        "rotationMassCurveMultiplier": 1
      }
    },
    "facadeFuelOverride": {
      "loadout": {
        "Ship": "SideWinder",
        "UnladenMass": 26,
        "Modules": [
          { "Slot": "PowerPlant", "Item": "Int_PowerPlant_Size2_Class5" },
          { "Slot": "MainEngines", "Item": "Int_Engine_Size2_Class2" },
          { "Slot": "Armour", "Item": "SideWinder_Armour_Grade1" },
          { "Slot": "FrameShiftDrive", "Item": "Int_Hyperdrive_Size2_Class1" },
          { "Slot": "LifeSupport", "Item": "Int_LifeSupport_Size1_Class1" },
          {
            "Slot": "PowerDistributor",
            "Item": "Int_PowerDistributor_Size1_Class1"
          },
          { "Slot": "Radar", "Item": "Int_Sensors_Size1_Class1" },
          { "Slot": "FuelTank", "Item": "Int_FuelTank_Size2_Class3" },
          { "Slot": "CargoHatch", "Item": "ModularCargoBayDoor" }
        ]
      },
      "options": { "fuel": 2 },
      "expected": {
        "speed": 232.77881613098572,
        "boost": 338.58736891779745,
        "pitch": 44.43959217046091,
        "roll": 116.38940806549286,
        "yaw": 16.92936844588987,
        "massCurveMultiplier": 1.058085527868117,
        "rotationMassCurveMultiplier": 1.058085527868117
      },
      "invalidLoads": [
        { "options": { "fuel": -1 }, "expectedError": "RangeError" },
        { "options": { "cargo": -1 }, "expectedError": "RangeError" }
      ]
    },
    "invalidSpeedEndpoints": {
      "input": {
        "minimumSpeed": 2,
        "maximumSpeed": 1,
        "boost": 1,
        "minPitch": 1,
        "pitch": 1,
        "minRoll": 1,
        "roll": 1,
        "minYaw": 1,
        "yaw": 1,
        "mass": 1,
        "thrusters": {
          "minMass": 1,
          "optMass": 1,
          "maxMass": 1,
          "minMultiplier": 1,
          "optMultiplier": 1,
          "maxMultiplier": 1
        }
      },
      "expectedError": "RangeError"
    }
  },
  "shieldRecovery": {
    "input": {
      "strength": 200,
      "regenRate": 2,
      "brokenRegenRate": 4,
      "distributorDraw": 0.6,
      "systemsCapacity": 20,
      "systemsRecharge": 2
    },
    "expected": {
      "regenRate": 2,
      "brokenRegenRate": 4,
      "recoveryTime": 41,
      "regenTime": 50
    },
    "pipAllocation": {
      "input": {
        "strength": 1000,
        "regenRate": 10,
        "brokenRegenRate": 20,
        "distributorDraw": 0.6,
        "systemsCapacity": 10,
        "systemsRecharge": 2,
        "systemsPips": 2
      },
      "expected": {
        "regenRate": 10,
        "brokenRegenRate": 20,
        "recoveryTime": 326.814304135525,
        "regenTime": 310.814304135525
      }
    },
    "invalidStrength": {
      "input": {
        "strength": -1,
        "regenRate": 1,
        "brokenRegenRate": 1,
        "distributorDraw": 0,
        "systemsCapacity": 0,
        "systemsRecharge": 0
      },
      "expectedError": "RangeError"
    }
  },
  "cellBanks": {
    "input": [
      {
        "slot": "Slot01_Size6",
        "symbol": "bank-a",
        "reinforcementRate": 12,
        "cells": 4,
        "spinUp": 5,
        "duration": 1,
        "heat": 170,
        "powered": true
      },
      {
        "slot": "Slot02_Size5",
        "symbol": "bank-b",
        "reinforcementRate": 8,
        "cells": 3,
        "spinUp": 4,
        "duration": 2,
        "heat": 120,
        "powered": false
      }
    ],
    "expected": { "totalRestorable": 48, "totalCells": 4, "powered": [true, false] }
  },
  "exclusivity": {
    "group": "shieldGenerator",
    "expectedCode": "duplicateExclusiveModule"
  },
  "moduleLimits": {
    "group": "experimentalWeapon",
    "input": [
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitIncrease": { "group": "experimentalWeapon", "amount": 1 } }
    ],
    "expectedUsage": {
      "group": "experimentalWeapon",
      "baseLimit": 4,
      "increase": 1,
      "limit": 5,
      "count": 6,
      "excess": 1
    },
    "expectedIssue": {
      "code": "moduleLimitExceeded",
      "params": { "group": "experimentalWeapon", "count": 6, "limit": 5 }
    },
    "catalogue": {
      "limitedCount": 33,
      "weapon": "Hpt_Guardian_GaussCannon_Fixed_Small",
      "increases": [
        { "symbol": "Int_ExpModuleStabiliser_Size3_Class3", "amount": 1 },
        { "symbol": "Int_ExpModuleStabiliser_Size5_Class3", "amount": 2 }
      ]
    },
    "removal": {
      "ship": "Anaconda",
      "slot": "Slot05_Size5",
      "stabiliser": "Int_ExpModuleStabiliser_Size3_Class3",
      "weaponSlots": [
        "HugeHardpoint1",
        "LargeHardpoint1",
        "LargeHardpoint2",
        "LargeHardpoint3",
        "MediumHardpoint1"
      ],
      "expected": {
        "key": "Slot05_Size5",
        "removable": false,
        "immovableReason": "moduleLimit"
      }
    }
  },
  "retailCredits": {
    "ship": "Anaconda",
    "expected": { "hull": 142456440, "modules": 4522132, "rebuy": 7348928 }
  },
  "mercCoinCost": {
    "ship": "Python",
    "modules": [
      {
        "slot": "MediumHardpoint1",
        "symbol": "Hpt_Railgun_Fixed_Medium",
        "blueprint": "RailGun_LongShot",
        "cost": 950
      },
      {
        "slot": "MediumHardpoint2",
        "symbol": "Hpt_MultiCannon_Fixed_Medium",
        "blueprint": "MultiCannon_Rapid",
        "cost": 850
      }
    ],
    "expected": 1800
  },
  "weapons": {
    "input": [{ "thermalLoad": 8 }, { "thermalLoad": 90 }],
    "expectedThermalLoad": 98
  },
  "distributor": {
    "input": {
      "systemsCapacity": 11,
      "systemsRecharge": 1.1,
      "enginesCapacity": 22,
      "enginesRecharge": 2.2,
      "weaponsCapacity": 33,
      "weaponsRecharge": 3.3,
      "systemsPips": 1,
      "enginesPips": 2,
      "weaponsPips": 3
    },
    "expected": {
      "systems": {
        "capacity": 11,
        "ratedRecharge": 1.1,
        "rechargeRate": 0.23940140490643413
      },
      "engines": {
        "capacity": 22,
        "ratedRecharge": 2.2,
        "rechargeRate": 1.0263362906904883
      },
      "weapons": {
        "capacity": 33,
        "ratedRecharge": 3.3,
        "rechargeRate": 2.4048131032111066
      },
      "pips": { "systems": 1, "engines": 2, "weapons": 3 }
    },
    "facade": {
      "note": "Import stocks every fixed mount this event leaves unnamed, so five stock core internals, the stock armour and the hatch draw power here too: 8.81 MW retracted, 16.28 MW deployed. The size-3 class-3 plant's 10 MW sits between them, which is what keeps the distributor's own band lit with the hardpoints stowed and dark with them run out.",
      "loadout": {
        "Ship": "Anaconda",
        "Modules": [
          { "Slot": "PowerPlant", "Item": "Int_Powerplant_Size3_Class3" },
          {
            "Slot": "PowerDistributor",
            "Item": "Int_PowerDistributor_Size6_Class2",
            "Priority": 4,
            "Engineering": {
              "BlueprintName": "PowerDistributor_PriorityEngines",
              "Level": 5,
              "Quality": 1,
              "Modifiers": [
                { "Label": "WeaponsCapacity", "Value": 32.299999 },
                { "Label": "WeaponsRecharge", "Value": 3.705 },
                { "Label": "EnginesCapacity", "Value": 41.600002 },
                { "Label": "EnginesRecharge", "Value": 3.456 },
                { "Label": "SystemsCapacity", "Value": 22.1 },
                { "Label": "SystemsRecharge", "Value": 2.04 }
              ]
            }
          },
          {
            "Slot": "HugeHardpoint1",
            "Item": "Hpt_BeamLaser_Fixed_Huge",
            "Priority": 0
          },
          {
            "Slot": "LargeHardpoint1",
            "Item": "Hpt_BeamLaser_Fixed_Large",
            "Priority": 0
          },
          {
            "Slot": "LargeHardpoint2",
            "Item": "Hpt_BeamLaser_Fixed_Large",
            "Priority": 0
          },
          {
            "Slot": "LargeHardpoint3",
            "Item": "Hpt_BeamLaser_Fixed_Large",
            "Priority": 0
          }
        ]
      },
      "options": { "systemsPips": 1, "enginesPips": 3, "weaponsPips": 2 },
      "expected": {
        "systems": {
          "capacity": 22.1,
          "ratedRecharge": 2.04,
          "rechargeRate": 0.44398078728102325
        },
        "engines": {
          "capacity": 41.600002,
          "ratedRecharge": 3.456,
          "rechargeRate": 2.5184951771810864
        },
        "weapons": {
          "capacity": 32.299999,
          "ratedRecharge": 3.705,
          "rechargeRate": 1.7284436168219357
        },
        "pips": { "systems": 1, "engines": 3, "weapons": 2 }
      },
      "nullLoadoutsNote": "An imported build always has a distributor — import stocks the mount from the hull defaults whether the event named an unresolvable article there or named none at all — so the metrics go null only when that distributor has no power: switched off at the mount, or fitted to a plant that cannot carry the load.",
      "nullLoadouts": [
        {
          "Ship": "Anaconda",
          "Modules": [
            {
              "Slot": "PowerDistributor",
              "Item": "Int_PowerDistributor_Size8_Class1",
              "On": false
            }
          ]
        },
        {
          "Ship": "Anaconda",
          "Modules": [
            { "Slot": "PowerPlant", "Item": "Int_Powerplant_Size2_Class1" },
            { "Slot": "PowerDistributor", "Item": "Int_PowerDistributor_Size8_Class1" }
          ]
        }
      ]
    }
  },
  "weaponsCapacitor": {
    "input": {
      "weaponsCapacity": 20,
      "weaponsRecharge": 5,
      "sustainedEnergyPerSecond": 7,
      "weaponsPips": 2
    },
    "expected": {
      "weaponsPips": 2,
      "capacity": 20,
      "rechargeRate": 2.3325824788420184,
      "sustainedEnergyPerSecond": 7,
      "netDrainRate": 4.667417521157981,
      "timeToDrain": 4.285024836397756
    }
  },
  "importRejections": {
    "unknownHull": {
      "input": { "Ship": "FutureHull", "Modules": [] },
      "expected": { "accepted": false, "reason": "unknownHull" }
    }
  },
  "diagnostics": {
    "slef": {
      "input": { "Ship": "sidewinder", "Modules": [{ "Slot": "PowerPlant" }] },
      "expected": {
        "code": "invalidModule",
        "path": "entries[0].Modules[0].Item",
        "constraint": "stringRequired"
      }
    },
    "loadout": {
      "input": {
        "Ship": "Anaconda",
        "Modules": [
          { "Slot": "FrameShiftDrive", "Item": "Int_Hyperdrive_Size8_Class5" }
        ]
      },
      "expected": {
        "code": "incompatibleModule",
        "params": {
          "slot": "FrameShiftDrive",
          "symbol": "Int_Hyperdrive_Size8_Class5",
          "constraint": "oversized",
          "moduleClass": 8,
          "slotSize": 6
        }
      }
    },
    "restrictedLoadout": {
      "input": {
        "Ship": "Anaconda",
        "Modules": [
          {
            "Slot": "MainEngines",
            "Item": "Int_Engine_Size7_Class5_GravityOptimised_MkII"
          }
        ]
      },
      "expected": {
        "code": "incompatibleModule",
        "params": {
          "slot": "MainEngines",
          "symbol": "Int_Engine_Size7_Class5_GravityOptimised_MkII",
          "constraint": "restrictedHull",
          "allowedShipNames": ["Caspian Explorer"],
          "allowedShipSymbols": ["Explorer_NX"],
          "shipSymbol": "Anaconda"
        }
      }
    },
    "wrongArmourLoadout": {
      "input": {
        "Ship": "Anaconda",
        "Modules": [{ "Slot": "Armour", "Item": "SideWinder_Armour_Grade1" }]
      },
      "expected": {
        "code": "incompatibleModule",
        "params": {
          "slot": "Armour",
          "symbol": "SideWinder_Armour_Grade1",
          "constraint": "wrongHullArmour",
          "armourShipName": "Sidewinder",
          "armourShipSymbol": "SideWinder",
          "shipSymbol": "Anaconda",
          "shipName": "Anaconda"
        }
      }
    },
    "calculation": {
      "input": { "slot": "Slot01_Size4", "symbol": "UnknownRack", "mass": 0 },
      "expected": {
        "field": "cargoCapacity",
        "reason": "unresolved",
        "slot": "Slot01_Size4",
        "symbol": "UnknownRack",
        "params": {
          "field": "cargoCapacity",
          "reason": "unresolved",
          "slot": "Slot01_Size4",
          "symbol": "UnknownRack"
        }
      }
    }
  },
  "editorErrors": {
    "incompatibleModule": {
      "ship": "Anaconda",
      "slot": "FrameShiftDrive",
      "module": "Int_Hyperdrive_Size8_Class5",
      "expected": {
        "code": "incompatibleModule",
        "constraint": "oversized",
        "params": {
          "slot": "FrameShiftDrive",
          "symbol": "Int_Hyperdrive_Size8_Class5",
          "constraint": "oversized",
          "moduleClass": 8,
          "slotSize": 6
        }
      }
    },
    "duplicateExclusiveModule": {
      "ship": "Anaconda",
      "firstSlot": "Slot01_Size7",
      "secondSlot": "Slot02_Size6",
      "module": "Int_ShieldGenerator_Size6_Class3",
      "expected": {
        "code": "duplicateExclusiveModule",
        "params": {
          "exclusionGroup": "shieldGenerator",
          "slot": "Slot02_Size6",
          "symbol": "Int_ShieldGenerator_Size6_Class3",
          "previousSlot": "Slot01_Size7",
          "previousSymbol": "Int_ShieldGenerator_Size6_Class3"
        }
      }
    },
    "moduleLimitExceeded": {
      "ship": "Anaconda",
      "fittedSlots": [
        "HugeHardpoint1",
        "LargeHardpoint1",
        "LargeHardpoint2",
        "LargeHardpoint3"
      ],
      "targetSlot": "MediumHardpoint1",
      "module": "Hpt_Guardian_GaussCannon_Fixed_Small",
      "expected": {
        "code": "moduleLimitExceeded",
        "params": {
          "group": "experimentalWeapon",
          "count": 5,
          "limit": 4,
          "slot": "MediumHardpoint1",
          "symbol": "Hpt_Guardian_GaussCannon_Fixed_Small"
        }
      }
    },
    "immutableSlot": {
      "ship": "SideWinder",
      "slot": "CargoHatch",
      "expected": {
        "code": "immutableSlot",
        "params": { "slot": "CargoHatch" }
      }
    },
    "requiredSlot": {
      "input": {
        "Ship": "SideWinder",
        "Modules": [{ "Slot": "powerplant", "Item": "FuturePowerPlant" }]
      },
      "slot": "PowerPlant",
      "expected": {
        "code": "requiredSlot",
        "params": { "slot": "PowerPlant" }
      }
    },
    "immutableSlotReplacement": {
      "ship": "SideWinder",
      "slot": "CargoHatch",
      "module": "Int_Hyperdrive_Size2_Class5",
      "expected": {
        "code": "immutableSlot",
        "params": { "slot": "CargoHatch" }
      }
    }
  },
  "slotRemoval": {
    "ship": "SideWinder",
    "expected": [
      {
        "key": "CargoHatch",
        "kind": "cargoHatch",
        "size": 1,
        "removable": false,
        "immovableReason": "cargoHatch"
      },
      {
        "key": "PowerPlant",
        "kind": "core",
        "size": 2,
        "removable": false,
        "immovableReason": "requiredSlot"
      },
      {
        "key": "Armour",
        "kind": "armour",
        "size": 0,
        "removable": false,
        "immovableReason": "requiredSlot"
      }
    ]
  }
}
