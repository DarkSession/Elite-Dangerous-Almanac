  "thrusterMass": {
    "input": {
      "slot": "MainEngines",
      "symbol": "Int_Engine_Size2_Class1",
      "thrusterMaxMass": 72
    },
    "cases": [
      {
        "name": "too heavy before it is even fuelled",
        "mass": {
          "dry": 85.6,
          "fuel": 8,
          "cargo": 16
        },
        "expectedIssue": {
          "code": "thrusterMassExceeded",
          "severity": "error",
          "message": "MainEngines: Int_Engine_Size2_Class1 is rated to 72 t but the ship weighs 85.6 t before fuel",
          "params": {
            "slot": "MainEngines",
            "symbol": "Int_Engine_Size2_Class1",
            "load": "dry",
            "mass": 85.6,
            "maxMass": 72
          }
        }
      },
      {
        "name": "flies dry, but never leaves a pad with a full tank",
        "mass": {
          "dry": 68,
          "fuel": 8,
          "cargo": 16
        },
        "expectedIssue": {
          "code": "thrusterMassExceeded",
          "severity": "error",
          "message": "MainEngines: Int_Engine_Size2_Class1 is rated to 72 t but the ship weighs 76 t with a full tank",
          "params": {
            "slot": "MainEngines",
            "symbol": "Int_Engine_Size2_Class1",
            "load": "unladen",
            "mass": 76,
            "maxMass": 72
          }
        }
      },
      {
        "name": "flies fuelled, and only a full hold sinks it",
        "mass": {
          "dry": 60,
          "fuel": 8,
          "cargo": 16
        },
        "expectedIssue": {
          "code": "thrusterMassExceeded",
          "severity": "warning",
          "message": "MainEngines: Int_Engine_Size2_Class1 is rated to 72 t but the ship weighs 84 t fully laden",
          "params": {
            "slot": "MainEngines",
            "symbol": "Int_Engine_Size2_Class1",
            "load": "laden",
            "mass": 84,
            "maxMass": 72
          }
        }
      }
    ],
    "quiet": [
      {
        "dry": 56,
        "fuel": 8,
        "cargo": 8
      },
      {
        "dry": 68
      },
      {
        "dry": 68,
        "cargo": 400
      }
    ]
  },
