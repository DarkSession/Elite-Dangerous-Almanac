/*
 * Shared test fixture — not shipped in any package.
 *
 * Cross-language parity cases for loaded mobility, shield recovery, shield-cell pools,
 * one-per-ship and counted-module validation, direct retail pricing, alpha-strike
 * thermal load and structured SLEF diagnostics. Inputs pin the public data-free
 * contracts; catalogue-backed expectations pin the shared ship and module snapshots.
 */
{
  "mobility": {
    "input": {
      "speed": 200,
      "boost": 300,
      "pitch": 40,
      "roll": 100,
      "yaw": 20,
      "minThrust": 40,
      "mass": 90,
      "thrusters": {
        "minMass": 70,
        "optMass": 90,
        "maxMass": 200,
        "minMultiplier": 0.9,
        "optMultiplier": 1.1,
        "maxMultiplier": 1.2,
        "speedCurve": {
          "minMass": 70,
          "optMass": 90,
          "maxMass": 200,
          "minMultiplier": 0.9,
          "optMultiplier": 1.25,
          "maxMultiplier": 1.6
        },
        "rotationCurve": {
          "minMass": 70,
          "optMass": 90,
          "maxMass": 200,
          "minMultiplier": 0.9,
          "optMultiplier": 1.1,
          "maxMultiplier": 1.3
        }
      }
    },
    "expected": {
      "speed": 250,
      "boost": 375,
      "pitch": 44,
      "roll": 110,
      "yaw": 22,
      "massCurveMultiplier": 1.25,
      "rotationMassCurveMultiplier": 1.1
    }
  },
  "shieldRecovery": {
    "input": {
      "strength": 200,
      "regenRate": 2,
      "brokenRegenRate": 4,
      "distributorDraw": 0.6,
      "systemsCapacity": 20,
      "systemsRecharge": 2
    },
    "expected": {
      "regenRate": 2,
      "brokenRegenRate": 4,
      "recoveryTime": 41,
      "regenTime": 50
    }
  },
  "cellBanks": {
    "input": [
      {
        "slot": "Slot01_Size6",
        "symbol": "bank-a",
        "reinforcementRate": 12,
        "cells": 4,
        "spinUp": 5,
        "duration": 1,
        "heat": 170
      },
      {
        "slot": "Slot02_Size5",
        "symbol": "bank-b",
        "reinforcementRate": 8,
        "cells": 3,
        "spinUp": 4,
        "duration": 2,
        "heat": 120
      }
    ],
    "expected": { "totalRestorable": 96, "totalCells": 7 }
  },
  "exclusivity": {
    "group": "shieldGenerator",
    "expectedCode": "duplicateExclusiveModule"
  },
  "moduleLimits": {
    "group": "experimentalWeapon",
    "input": [
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitGroup": "experimentalWeapon" },
      { "limitIncrease": { "group": "experimentalWeapon", "amount": 1 } }
    ],
    "expectedUsage": {
      "group": "experimentalWeapon",
      "baseLimit": 4,
      "increase": 1,
      "limit": 5,
      "count": 6,
      "excess": 1
    },
    "expectedIssue": {
      "code": "moduleLimitExceeded",
      "params": { "group": "experimentalWeapon", "count": 6, "limit": 5 }
    },
    "catalogue": {
      "limitedCount": 33,
      "weapon": "Hpt_Guardian_GaussCannon_Fixed_Small",
      "increases": [
        { "symbol": "Int_ExpModuleStabiliser_Size3_Class3", "amount": 1 },
        { "symbol": "Int_ExpModuleStabiliser_Size5_Class3", "amount": 2 }
      ]
    }
  },
  "retailCredits": {
    "ship": "Anaconda",
    "expected": { "hull": 142456440, "modules": 4522132, "rebuy": 7348928 }
  },
  "weapons": {
    "input": [{ "thermalLoad": 8 }, { "thermalLoad": 90 }],
    "expectedThermalLoad": 98
  },
  "diagnostics": {
    "slef": {
      "input": { "Ship": "sidewinder", "Modules": [{ "Slot": "PowerPlant" }] },
      "expected": {
        "code": "invalidModule",
        "path": "entries[0].Modules[0].Item",
        "constraint": "stringRequired"
      }
    },
    "loadout": {
      "input": {
        "Ship": "Anaconda",
        "Modules": [{ "Slot": "FrameShiftDrive", "Item": "Int_Hyperdrive_Size8_Class5" }]
      },
      "expected": {
        "code": "incompatibleModule",
        "params": {
          "slot": "FrameShiftDrive",
          "symbol": "Int_Hyperdrive_Size8_Class5",
          "constraint": "oversized",
          "moduleClass": 8,
          "slotSize": 6
        }
      }
    },
    "calculation": {
      "input": { "slot": "Slot01_Size4", "symbol": "UnknownRack", "mass": 0 },
      "expected": {
        "field": "cargoCapacity",
        "slot": "Slot01_Size4",
        "symbol": "UnknownRack",
        "params": {
          "field": "cargoCapacity",
          "slot": "Slot01_Size4",
          "symbol": "UnknownRack"
        }
      }
    }
  },
  "slotRemoval": {
    "ship": "SideWinder",
    "expected": {
      "key": "CargoHatch",
      "kind": "cargoHatch",
      "size": 1,
      "removable": false,
      "immovableReason": "cargoHatch"
    }
  }
}
