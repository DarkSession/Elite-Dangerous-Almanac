      }
    },
    "facade": {
      "note": "Import stocks every fixed mount this event leaves unnamed, so four of the five stocked core internals and the hatch draw power here too -- the stock armour and fuel tank draw none: 8.81 MW retracted, 16.28 MW deployed. The size-3 class-3 plant's 10 MW sits between them, which is what keeps the distributor's own band lit with the hardpoints stowed and dark with them run out.",
      "loadout": {
        "Ship": "Anaconda",
        "Modules": [
          {
            "Slot": "PowerPlant",
            "Item": "Int_Powerplant_Size3_Class3"
          },
          {
            "Slot": "PowerDistributor",
            "Item": "Int_PowerDistributor_Size6_Class2",
            "Priority": 4,
            "Engineering": {
              "BlueprintName": "PowerDistributor_PriorityEngines",
              "Level": 5,
              "Quality": 1,
              "Modifiers": [
                {
                  "Label": "WeaponsCapacity",
                  "Value": 32.299999
                },
                {
                  "Label": "WeaponsRecharge",
                  "Value": 3.705
                },
                {
                  "Label": "EnginesCapacity",
                  "Value": 41.600002
                },
                {
                  "Label": "EnginesRecharge",
                  "Value": 3.456
                },
                {
                  "Label": "SystemsCapacity",
                  "Value": 22.1
                },
                {
                  "Label": "SystemsRecharge",
                  "Value": 2.04
                }
              ]
            }
          },
          {
            "Slot": "HugeHardpoint1",
            "Item": "Hpt_BeamLaser_Fixed_Huge",
            "Priority": 0
          },
          {
            "Slot": "LargeHardpoint1",
            "Item": "Hpt_BeamLaser_Fixed_Large",
            "Priority": 0
          },
          {
            "Slot": "LargeHardpoint2",
            "Item": "Hpt_BeamLaser_Fixed_Large",
            "Priority": 0
          },
          {
            "Slot": "LargeHardpoint3",
            "Item": "Hpt_BeamLaser_Fixed_Large",
            "Priority": 0
          }
        ]
      },
      "options": {
        "systemsPips": 1,
        "enginesPips": 3,
        "weaponsPips": 2
      },
      "expected": {
        "systems": {
          "capacity": 22.1,
          "ratedRecharge": 2.04,
          "rechargeRate": 0.44398078728102325
        },
        "engines": {
          "capacity": 41.600002,
          "ratedRecharge": 3.456,
          "rechargeRate": 2.5184951771810864
        },
        "weapons": {
          "capacity": 32.299999,
          "ratedRecharge": 3.705,
          "rechargeRate": 1.7284436168219357
        },
        "pips": {
          "systems": 1,
          "engines": 3,
          "weapons": 2
        }
      },
      "nullLoadoutsNote": "An imported build always has a distributor — import stocks the mount from the hull defaults whether the event named an unresolvable article there or named none at all — so the metrics go null only when that distributor has no power: switched off at the mount, or fitted to a plant that cannot carry the load.",
      "nullLoadouts": [
        {
          "Ship": "Anaconda",
          "Modules": [
