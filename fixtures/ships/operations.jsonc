/*
 * Shared test fixture — not shipped in any package.
 *
 * Cross-language parity cases for loaded mobility, shield recovery, distributor
 * recharge, WEP-capacitor endurance, shield-cell pools, one-per-ship,
 * counted-module and thruster-mass validation, direct credit, Merc Coin and material
 * pricing, alpha-strike thermal load, import rejections, recipes stated without
 * modifiers, structured diagnostics and editor failures. Inputs pin the public data-free
 * and ShipLoadout facade contracts; catalogue-backed expectations pin the shared ship and
 * module snapshots.
 */
{
  "mobility": {
    "input": {
      "minimumSpeed": 80,
      "maximumSpeed": 200,
      "boost": 300,
      "minPitch": 16,
      "pitch": 40,
      "minRoll": 40,
      "roll": 100,
      "minYaw": 8,
      "yaw": 20,
      "mass": 90,
      "thrusters": {
        "minMass": 70,
        "optMass": 90,
        "maxMass": 200,
        "minMultiplier": 0.9,
        "optMultiplier": 1.1,
        "maxMultiplier": 1.2,
        "speedCurve": {
          "minMass": 70,
          "optMass": 90,
          "maxMass": 200,
          "minMultiplier": 0.9,
          "optMultiplier": 1.25,
          "maxMultiplier": 1.6
        },
        "rotationCurve": {
          "minMass": 70,
          "optMass": 90,
          "maxMass": 200,
          "minMultiplier": 0.9,
          "optMultiplier": 1.1,
          "maxMultiplier": 1.3
        }
      }
    },
    "expected": {
      "speed": 250,
      "boost": 375,
      "pitch": 44,
      "roll": 110,
      "yaw": 22,
      "massCurveMultiplier": 1.25,
      "rotationMassCurveMultiplier": 1.1
    },
