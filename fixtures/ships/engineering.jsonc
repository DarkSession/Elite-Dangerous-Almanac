  "guardianZoneResistanceCapability": {
    "description": "Anti-Guardian Zone Resistance is a boolean capability rather than a numeric stat. The two Guardian Nanite Torpedo Pylons carry it inherently; other stock records omit the flag. Applying the recipe — on a Guardian module or on a Guardian weapon, which the game spells the same way — emits the same non-numeric journal modifier and makes the fitted module's effective `guardianZoneResistance` strictly true. The weapon case carries a different casing of that id, pinning that a lookup matches case-insensitively. Imports also grant it by label presence when a producer uses the numeric display value. The ordinary power plant case pins the compatibility boundary separately.",
    "field": "guardianZoneResistance",
    "offeredAs": "GuardianModule_Sturdy",
    "grade": 1,
    "modifier": {
      "Label": "GuardianModuleResistance",
      "ValueStr": "Active"
    },
    "numericImportedModifier": {
      "Label": "GuardianModuleResistance",
      "Value": 1,
      "OriginalValue": 0
    },
    "cases": [
      {
        "slot": "PowerPlant",
        "symbol": "Int_GuardianPowerplant_Size7",
        "blueprint": "GuardianModule_Sturdy"
      },
      {
        "slot": "MediumHardpoint1",
        "symbol": "Hpt_Guardian_GaussCannon_Fixed_Medium",
        "blueprint": "guardianmodule_sturdy"
      }
    ],
    "refused": {
      "slot": "PowerPlant",
      "symbol": "Int_Powerplant_Size7_Class5",
      "blueprint": "GuardianModule_Sturdy"
    }
