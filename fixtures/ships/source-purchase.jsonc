  "syntheticCaptures": {
    "noCredits": {
      "note": "A capture stating no credit figure at all has no purchase record to keep. A record of nulls would read as a source that priced the build at nothing.",
      "event": {
        "Ship": "sidewinder",
        "Modules": [
          {
            "Slot": "PowerPlant",
            "Item": "int_powerplant_size2_class1"
          }
        ]
      },
      "record": null
    },
    "rebuyOnly": {
      "note": "One stated figure is enough for a record; the rest stay null.",
      "event": {
        "Ship": "sidewinder",
        "Rebuy": 12345,
        "Modules": [
          {
            "Slot": "PowerPlant",
            "Item": "int_powerplant_size2_class1"
          }
        ]
      },
      "record": {
        "hullValue": null,
        "modulesValue": null,
        "rebuy": 12345,
        "moduleCount": 1,
        "pricedModulesValue": 0,
        "moduleValues": []
      }
    },
    "partsDoNotAddUp": {
      "note": "A journal omits Value on a module that was nonetheless paid for. Earlier Loadout events in the Viper Mk IV log declare ModulesValue 4940956 while their per-module figures sum to 3942898 -- the FSD interdictor was bought minutes before and is not yet priced. Both figures are reported, so the disagreement stays visible instead of being averaged away. The eight remaining fixed mounts are spelled out at their stock articles, unpriced, so the case isolates the unpriced module it is about: a core internal, bulkhead or hatch a capture leaves unnamed is stocked at import, and a stocked core internal voids the captured totals on its own. The approach suite this event leaves unnamed is stocked too and deliberately voids nothing, which is what lets the export under `editedExports.groups.partsDoNotAddUp` still carry this total; the record below is read off the raw event and stands either way.",
      "event": {
        "Ship": "viper_mkiv",
        "ModulesValue": 4940956,
        "Modules": [
          {
            "Slot": "PowerPlant",
            "Item": "int_powerplant_size4_class5",
            "Value": 3942898
          },
          {
            "Slot": "Slot01_Size4",
            "Item": "int_fsdinterdictor_size4_class3"
          },
          { "Slot": "Armour", "Item": "viper_mkiv_armour_grade1" },
          { "Slot": "MainEngines", "Item": "int_engine_size4_class1" },
          { "Slot": "FrameShiftDrive", "Item": "int_hyperdrive_size4_class1" },
          { "Slot": "LifeSupport", "Item": "int_lifesupport_size2_class1" },
          { "Slot": "PowerDistributor", "Item": "int_powerdistributor_size3_class1" },
          { "Slot": "Radar", "Item": "int_sensors_size3_class1" },
          { "Slot": "FuelTank", "Item": "int_fueltank_size4_class3" },
          { "Slot": "CargoHatch", "Item": "modularcargobaydoor" }
        ]
      },
      "record": {
        "hullValue": null,
        "modulesValue": 4940956,
        "rebuy": null,
        "moduleCount": 10,
        "pricedModulesValue": 3942898,
        "moduleValues": [
          {
            "slot": "PowerPlant",
            "item": "int_powerplant_size4_class5",
            "value": 3942898
          }
        ]
      }
    },
    "repeatedSlotKey": {
      "note": "A malformed capture naming one mount twice. The build keeps the last entry, so the record does too -- pricing the module that is not there would be worse than not pricing it.",
      "event": {
        "Ship": "sidewinder",
        "Modules": [
          {
            "Slot": "PowerPlant",
            "Item": "int_powerplant_size2_class1",
            "Value": 10
          },
          {
            "Slot": "PowerPlant",
            "Item": "int_powerplant_size2_class3",
            "Value": 30
          }
        ]
      },
      "record": {
        "hullValue": null,
        "modulesValue": null,
        "rebuy": null,
        "moduleCount": 2,
        "pricedModulesValue": 30,
        "moduleValues": [
          {
            "slot": "PowerPlant",
            "item": "int_powerplant_size2_class3",
            "value": 30
          }
        ]
      }
    }
  },
  "editedExports": {
    "note": "Each group starts from the capture its key names -- a real one from `captures`, or a hand-written one from `syntheticCaptures` -- applies its edits, then exports with the source-record credits. `unpricedSlots` lists the slots the capture priced that the export does not; every other priced slot carries the capture's own figure, and nothing else is priced at all.",
    "groups": {
      "deepBlack": {
        "note": "Fully priced and uniformly discounted, so every kind of edit is visible against a total its own parts account for exactly.",
        "scenarios": {
          "swapAPricedModule": {
            "edits": [
              {
                "setModule": {
                  "slot": "Slot13_Size1",
                  "symbol": "Int_CargoRack_Size1_Class1"
                }
              }
            ],
            "why": "The captured figure was paid for the supercruise assist that was fitted, not for the cargo rack now in the mount. The module totals cover an article no longer aboard, so they go too; HullValue stands, because a captured hull figure names no slot and no edit narrows it.",
            "topLevelCredits": {
              "HullValue": 189326510
            },
            "unpricedSlots": [
              "Slot13_Size1"
            ]
          },
          "removeAPricedModule": {
            "edits": [
              {
                "removeModule": {
                  "slot": "Slot13_Size1"
                }
              }
            ],
            "why": "Same reason as a swap: what the total counted is no longer fitted.",
            "topLevelCredits": {
              "HullValue": 189326510
            },
            "unpricedSlots": [
              "Slot13_Size1"
            ]
          },
          "refitTheSameArticle": {
            "edits": [
              {
                "setModule": {
                  "slot": "Slot13_Size1",
                  "symbol": "Int_CargoRack_Size1_Class1"
                }
              },
              {
                "setModule": {
                  "slot": "Slot13_Size1",
                  "symbol": "Int_SupercruiseAssist"
                }
              }
            ],
            "why": "The article the capture priced is back in the mount it was priced in, so its figure applies again and the totals hold.",
            "topLevelCredits": {
              "HullValue": 189326510,
              "ModulesValue": 192625195,
              "Rebuy": 19097585
            },
            "unpricedSlots": []
          },
          "engineerAPricedModule": {
            "edits": [
              {
                "applyBlueprint": {
                  "slot": "MainEngines",
                  "blueprint": "Engine_Dirty",
                  "grade": 3
                }
              }
