/*
 * Shared test fixture — not shipped in any package.
 *
 * Ground truth for the ship catalogue (data/ships/ships.jsonc, from EDCD FDevIDs and
 * EDCD/coriolis-data). `count` pins the catalogue size; `records` pins identity,
 * manufacturer and landing-pad size (with `entitlement` present only on gated hulls);
 * `lookups` pins the case-insensitive symbol/name resolution the journal relies on.
 */
{
  "count": 48,
  "records": [
    {
      "symbol": "SideWinder",
      "name": "Sidewinder",
      "manufacturer": "Faulcon DeLacy",
      "size": "small"
    },
    {
      "symbol": "Anaconda",
      "name": "Anaconda",
      "manufacturer": "Faulcon DeLacy",
      "size": "large"
    },
    {
      "symbol": "Empire_Trader",
      "name": "Imperial Clipper",
      "manufacturer": "Gutamaya",
      "size": "large"
    },
    {
      "symbol": "Type9",
      "name": "Type-9 Heavy",
      "manufacturer": "Lakon Spaceways",
      "size": "large"
    },
    {
      "symbol": "Krait_MkII",
      "name": "Krait MkII",
      "manufacturer": "Faulcon DeLacy",
      "size": "medium",
      "entitlement": "ELITE_HORIZONS_V_PLANETARY_LANDINGS"
    },
    {
      "symbol": "Python_NX",
      "name": "Python MkII",
      "manufacturer": "Faulcon DeLacy",
      "size": "medium",
      "entitlement": "ELITE_V_PYTHON_NX"
    }
  ],
  "lookups": [
    { "query": "empire_trader", "by": "symbol", "name": "Imperial Clipper" },
    { "query": "Empire_Trader", "by": "symbol", "name": "Imperial Clipper" },
    { "query": "imperial clipper", "by": "name", "symbol": "Empire_Trader" }
  ]
}
