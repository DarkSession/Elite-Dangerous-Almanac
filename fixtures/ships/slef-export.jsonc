    "journalTolerance": {
      "note": "The journal rounds; these are the source event's own figures, matched within 1e-4.",
      "UnladenMass": 388.830017,
      "MaxJumpRange": 60.547791
    },
    "discount": {
      "note": "The journal's credit figures differ from retail in three independent ways, which is why none of them is carried through: the modules were bought at a discount; the game reports HullValue as the hull WITH its stock fittings (coriolis `retailCost` 37472252) where we quote the bare hull (`hullCost` 35741519); and it gives no `Value` at all to the five modules that came free with the hull, so its ModulesValue counts fewer articles than ours.",
      "sourceHullValue": 37472252,
      "sourceModulesValue": 50785509,
      "sourceRebuy": 4412891,
      "hullRetailCost": 37472252,
      "unpricedInSource": [
        "Armour",
        "FuelTank",
        "Slot09_Size1",
        "PlanetaryApproachSuite",
        "CargoHatch"
      ]
    }
  },
  "viperMkIV": {
    "build": "fixtures/ships/journal-viper-mkiv.jsonc",
    "note": "A second real journal `Loadout` event, and the only ground-truth build here that carries no engineering at all: every module performs as the catalogue sells it, so Frontier's own `UnladenMass` and `MaxJumpRange` check the base stats directly instead of the engineered path the Krait Phantom exercises. Its credits are a purchase record like every other source's, but a uniform one — all 20 priced modules sit at 0.85 of list — which turns `discount` into a reading of the price table rather than a curiosity.",
    "topLevelKeys": [
      "event",
      "Ship",
      "ShipName",
      "ShipIdent",
      "HullValue",
      "ModulesValue",
      "UnladenMass",
      "CargoCapacity",
      "MaxJumpRange",
      "FuelCapacity",
      "Rebuy",
      "Modules"
    ],
    "moduleCount": 27,
    "nonOutfittingSlots": [
      "Decal1",
      "Decal2",
      "Decal3",
      "VesselVoice",
      "ShipCockpit"
    ],
    "recomputed": {
      "Ship": "viper_mkiv",
      "HullValue": 312797,
      "ModulesValue": 5832089,
      "UnladenMass": 260.8,
      "CargoCapacity": 0,
      "MaxJumpRange": 21.951648,
      "FuelCapacity": {
        "Main": 16,
        "Reserve": 0.46
      },
      "Rebuy": 307244
    },
    "journalTolerance": {
      "note": "The journal rounds; these are the source event's own figures, matched within 1e-4. Nothing on this build is engineered, so agreement here is agreement with the catalogue's own module masses and drive stats.",
      "UnladenMass": 260.799988,
      "MaxJumpRange": 21.951651
    },
    "discount": {
      "note": "Every priced module was bought at a flat 0.85 of catalogue list — 20 of them, each within a credit of the ratio after the game's own rounding, which is the widest external check the price table gets from a single source. The hull is the counter-case to the Krait Phantom: there the game's HullValue was the hull WITH its stock fittings (coriolis `retailCost`) to the credit; here it is 246650, below even the bare `hullCost`, and 0.85 of neither convention. So a journal's HullValue is not a second reading of the price table, and none of these figures is carried through.",
      "sourceHullValue": 246650,
      "sourceModulesValue": 4957276,
      "sourceRebuy": 260198,
      "hullRetailCost": 437931,
      "hullCost": 312797,
      "moduleDiscount": 0.85,
      "moduleDiscountToleranceCr": 1,
      "pricedInSource": 20,
      "rebuyFromOwnFigures": 260196,
      "unpricedInSource": ["Armour", "CargoHatch"]
    }
  },
  "pythonMkII": {
    "build": "fixtures/ships/journal-python-mkii-antixeno.jsonc",
    "note": "A third real journal `Loadout` event, and the second carrying no engineering at all — so, like the Viper Mk IV, Frontier's own `UnladenMass` and `MaxJumpRange` check the base stats directly. What it adds is coverage neither other capture has: the Python Mk II hull, and six anti-xeno and Guardian hardpoints whose clip and ammo figures the game reports back as `AmmoInClip` / `AmmoInHopper`. Four of its weapons are in groups this catalogue gives no engineering menu (the Enhanced AX pair, the Guardian Nanite Torpedo Pylon and the Remote Release Flak Launcher), so it also exercises a build made largely of modules `getBlueprintsForModule` answers `[]` for.",
    "topLevelKeys": [
      "event",
      "Ship",
      "ShipName",
      "ShipIdent",
      "HullValue",
      "ModulesValue",
      "UnladenMass",
      "CargoCapacity",
      "MaxJumpRange",
      "FuelCapacity",
      "Rebuy",
      "Modules"
    ],
    "moduleCount": 22,
    "nonOutfittingSlots": ["VesselVoice", "ShipCockpit"],
    "recomputed": {
      "Ship": "python_nx",
      "HullValue": 64743724,
      "ModulesValue": 9774469,
      "UnladenMass": 699,
      "CargoCapacity": 8,
      "MaxJumpRange": 17.49517,
      "FuelCapacity": {
        "Main": 16,
        "Reserve": 0.83
      },
      "Rebuy": 3725909
    },
    "journalTolerance": {
      "note": "The journal rounds; these are the source event's own figures, matched within 1e-4. Nothing on this build is engineered, so agreement is agreement with the catalogue's own module masses and drive stats.",
      "UnladenMass": 699.0,
      "MaxJumpRange": 17.495169
    },
    "ammunition": {
      "note": "The game reports the loaded weapons' magazine and reserve, which is one of two external checks on `clipSize` and `ammoMaximum` a journal gives; the other, stronger one is the `AmmoClipSize` / `AmmoMaximum` modifier an engineered module states. Both weapons are sitting at capacity, so each figure below is also what a parsed build reports for that weapon. Only the two weapons carrying ammo at capture time say anything — the other four report zero on both counts, which is a fact about this ship's rearm state and not about the catalogue, so they are not pinned. The counts themselves are read off the capture rather than off a parsed build, because a build carries no rearm state: `AmmoInClip` and `AmmoInHopper` are dropped on import by design, and what a weapon can hold is reported from the catalogue stats instead.",
      "loaded": [
        {
          "symbol": "Hpt_ATMultiCannon_Fixed_Large_V2",
          "AmmoInClip": 100,
          "AmmoInHopper": 2100
        },
        {
          "symbol": "Hpt_Guardian_ShardCannon_Fixed_Large",
          "AmmoInClip": 5,
          "AmmoInHopper": 180
        }
      ]
    },
    "discount": {
      "note": "All 18 priced modules were bought at 0.8775 of catalogue list, each within a credit after the game's own rounding — a second, independent reading of the price table beside the Viper Mk IV's flat 0.85, at a different discount. The residual credit splits cleanly: the 12 internals land exactly on the floor of the ratio, the six hardpoints one credit above it, which is a rounding rule this repository does not model and does not need to. The hull agrees with the Viper Mk IV rather than the Krait Phantom: 56801651 is below even the bare `hullCost` and is 0.8775 of neither convention, so a journal's HullValue is not a second reading of the price table and none of these figures is carried through.",
      "sourceHullValue": 56801651,
      "sourceModulesValue": 8577094,
      "sourceRebuy": 3268938,
      "hullRetailCost": 67527359,
      "hullCost": 64743724,
      "moduleDiscount": 0.8775,
      "moduleDiscountToleranceCr": 1,
      "pricedInSource": 18,
      "rebuyFromOwnFigures": 3268937,
      "unpricedInSource": ["Armour", "CargoHatch"]
    }
  },
