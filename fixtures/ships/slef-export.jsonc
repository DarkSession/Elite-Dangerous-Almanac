  "kraitPhantom": {
    "build": "fixtures/ships/journal-krait-phantom.jsonc",
    "note": "A real journal `Loadout` event — Frontier's own figures, so `recomputed` is ground truth rather than a third-party calculator's reading. Unlike an EDSY export it also carries the cockpit, ship kit, nameplates, bobbles, paint and voice pack: 15 of its 40 `Modules` entries are not outfitting at all, and must contribute neither mass nor credits.",
    "topLevelKeys": [
      "event",
      "Ship",
      "ShipName",
      "ShipIdent",
      "HullValue",
      "ModulesValue",
      "UnladenMass",
      "CargoCapacity",
