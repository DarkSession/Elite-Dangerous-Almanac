  "viperMkIV": {
    "build": "fixtures/ships/journal-viper-mkiv.jsonc",
    "note": "A second real journal `Loadout` event, and the only ground-truth build here that carries no engineering at all: every module performs as the catalogue sells it, so Frontier's own `UnladenMass` and `MaxJumpRange` check the base stats directly instead of the engineered path the Krait Phantom exercises. Its credits are a purchase record like every other source's, but a uniform one — all 20 priced modules sit at 0.85 of list — which turns `discount` into a reading of the price table rather than a curiosity.",
    "topLevelKeys": [
      "event",
      "Ship",
      "ShipName",
      "ShipIdent",
      "HullValue",
      "ModulesValue",
      "UnladenMass",
      "CargoCapacity",
      "MaxJumpRange",
      "FuelCapacity",
      "Rebuy",
      "Modules"
    ],
    "moduleCount": 27,
    "nonOutfittingSlots": [
      "Decal1",
      "Decal2",
      "Decal3",
      "VesselVoice",
      "ShipCockpit"
    ],
    "recomputed": {
