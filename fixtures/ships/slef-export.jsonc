  "engineeringWithoutModifiers": {
    "note": "SLEF requires only Ship, Modules, Slot and Item; the specification's own example carries an Engineering block with BlueprintName, Level, Quality and ExperimentalEffect but NO Modifiers array. A parser that requires Modifiers cannot read the format it implements. Absent means 'not stated', not 'changed nothing': the module performs at its catalogue stats, modifier lookups return null, and an export must not invent an empty array on the way back out. Source: https://inara.cz/elite/inara-impexp-slef/",
    "modifiersRequired": false,
    "exportInventsEmptyArray": false
  },
  "journalFieldExclusions": {
    "note": "Fields a real journal capture may carry but the durable build deliberately does not. timestamp identifies the capture; ShipID identifies that journal's ship instance; HullHealth and Hot are transient ship state. Engineer and EngineerID record who applied engineering, and BlueprintID is redundant with BlueprintName. A journal -> ShipLoadout -> SLEF round trip drops these fields while retaining the engineering recipe, grade, quality, experimental effect and modifiers.",
    "topLevelBuild": "fixtures/ships/journal-viper-mkiv.jsonc",
    "topLevel": ["timestamp", "ShipID", "HullHealth", "Hot"],
    "engineeringBuild": "fixtures/ships/journal-krait-phantom.jsonc",
    "engineering": ["Engineer", "EngineerID", "BlueprintID"]
  },
