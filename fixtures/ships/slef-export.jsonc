        },
        {
          "action": "defaulted",
          "slot": "LifeSupport",
          "sourceSymbol": null,
          "replacementSymbol": "Int_LifeSupport_Size1_Class1"
        },
        {
          "action": "defaulted",
          "slot": "PowerDistributor",
          "sourceSymbol": null,
