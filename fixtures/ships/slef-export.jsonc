    "afterEdit": {
      "note": "Fitting a 5C fuel tank into Slot06_Size5, which held a 5D shield generator. Nothing is dropped, and nothing is adjusted in place: every figure is recomputed from the new fit, so ModulesValue swaps the generator's list price of 189035 for the tank's 97754.",
      "slot": "Slot06_Size5",
      "item": "Int_FuelTank_Size5_Class3",
      "topLevelKeys": [
        "event",
        "Ship",
