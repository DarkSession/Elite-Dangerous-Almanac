      "HullValue": 312797,
      "ModulesValue": 5832089,
      "UnladenMass": 260.8,
      "CargoCapacity": 0,
      "MaxJumpRange": 21.951648,
      "FuelCapacity": {
        "Main": 16,
        "Reserve": 0.46
      },
      "Rebuy": 307244
    },
    "journalTolerance": {
      "note": "The journal rounds; these are the source event's own figures, matched within 1e-4. Nothing on this build is engineered, so agreement here is agreement with the catalogue's own module masses and drive stats.",
      "UnladenMass": 260.799988,
      "MaxJumpRange": 21.951651
    },
    "discount": {
      "note": "Every priced module was bought at a flat 0.85 of catalogue list — 20 of them, each within a credit of the ratio after the game's own rounding, which is the widest external check the price table gets from a single source. The hull is the counter-case to the Krait Phantom: there the game's HullValue was the hull WITH its stock fittings (coriolis `retailCost`) to the credit; here it is 246650, below even the bare `hullCost`, and 0.85 of neither convention. So a journal's HullValue is not a second reading of the price table, and none of these figures is carried through.",
      "sourceHullValue": 246650,
      "sourceModulesValue": 4957276,
      "sourceRebuy": 260198,
      "hullRetailCost": 437931,
      "hullCost": 312797,
      "moduleDiscount": 0.85,
      "moduleDiscountToleranceCr": 1,
      "pricedInSource": 20,
      "rebuyFromOwnFigures": 260196,
      "unpricedInSource": ["Armour", "CargoHatch"]
    }
  },
  "pythonMkII": {
    "build": "fixtures/ships/journal-python-mkii-antixeno.jsonc",
    "note": "A third real journal `Loadout` event, and the second carrying no engineering at all — so, like the Viper Mk IV, Frontier's own `UnladenMass` and `MaxJumpRange` check the base stats directly. What it adds is coverage neither other capture has: the Python Mk II hull, and six anti-xeno and Guardian hardpoints whose clip and ammo figures the game reports back as `AmmoInClip` / `AmmoInHopper`. Four of its weapons are in groups this catalogue gives no engineering menu (the Enhanced AX pair, the Guardian Nanite Torpedo Pylon and the Remote Release Flak Launcher), so it also exercises a build made largely of modules `getBlueprintsForModule` answers `[]` for.",
    "topLevelKeys": [
      "event",
      "Ship",
      "ShipName",
      "ShipIdent",
      "HullValue",
      "ModulesValue",
      "UnladenMass",
      "CargoCapacity",
      "MaxJumpRange",
      "FuelCapacity",
      "Rebuy",
      "Modules"
    ],
    "moduleCount": 22,
    "nonOutfittingSlots": ["VesselVoice", "ShipCockpit"],
