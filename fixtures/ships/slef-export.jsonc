/*
 * Shared test fixture — not shipped in any package.
 *
 * Expected ShipLoadout export output — the journal `Loadout` event and SLEF envelope a build
 * serialises to. Pins the decisions rather than whole blobs: which top-level keys an export emits
 * and which it leaves out, module order, and the lower-cased journal casing. This is the DEFAULT
 * export: every top-level figure is recomputed from the hull and the fitted modules, never echoed
 * from the import. Credits are quoted at RETAIL — the bare hull's `hullCost` plus every module's
 * catalogue list price — so they deliberately differ from what a source build reports, since that
 * records one commander's purchase at one station. Each build's `discount` section pins the ratio,
 * which is how the retail figures are shown to be right; `fixtures/ships/source-purchase.jsonc`
 * pins the same source totals and the opt-in export that quotes them. Cross-language validation.
 */
{
  "rebuyFraction": 0.05,
  "classification": {
    "note": "How an entry in `Modules` is decided to be an outfitting module, a non-outfitting fitting, or unknown — the rule that governs every mass and credit figure below. The catalogue has the FIRST say: an article it can identify contributes its mass and list price whatever its slot is called. Only an unidentifiable article is classified by slot. Known cosmetic/hull families are explicitly non-outfitting and contribute no mass or list price; a recognised outfitting mount, or any unfamiliar family, is unknown. Unknown omits the figures that depend on it rather than being counted as free and weightless, so a genuinely new mount cannot silently understate a build. Numbered decals, bobbles and nameplates remain open-ended inside their established families.",
    "outfittingSlotPatterns": [
      "^powerplant$",
      "^mainengines$",
      "^frameshiftdrive$",
      "^lifesupport$",
      "^powerdistributor$",
      "^radar$",
      "^fueltank$",
      "^armour$",
      "^cargohatch$",
      "^planetaryapproachsuite$",
      "^(small|medium|large|huge)(mining)?hardpoint\\d+$",
      "^tinyhardpoint\\d+$",
      "^military\\d+$",
      "^cargo\\d+$",
      "^limpetcontroller\\d+$",
      "^fighterbay\\d+$",
      "^passenger\\d+$",
      "^slot\\d+_size\\d+$"
    ],
    "nonOutfittingSlotPattern": "^(paintjob|shipname\\d+|shipid\\d+|bobble\\d+|decal\\d+|shipkit.+|weaponcolour|enginecolour|vesselvoice|shipcockpit|stringlights)$",
    "patternsMatchLowerCasedSlot": true,
    "examples": [
      {
        "slot": "FutureCoreSlot",
        "item": "int_hyperdrive_size5_class5",
        "verdict": "outfitting",
        "why": "The catalogue knows the article; an unfamiliar slot name does not make it free."
      },
      {
        "slot": "frameshiftdrive",
        "item": "int_hyperdrive_size5_class5",
        "verdict": "outfitting",
        "why": "Lower-cased slot keys are what the SLEF specification's own example uses."
      },
      {
        "slot": "Bobble10",
        "item": "bobble_christmastree",
        "verdict": "nonOutfitting",
        "why": "The open-ended bobble family is explicitly non-outfitting, without this numbered slot appearing in a capture."
      },
      {
        "slot": "Slot99_Size4",
        "item": "int_something_we_have_never_seen",
        "verdict": "unknown",
        "why": "The key names an optional mount, so something outfitting-like is fitted there, but no catalogue can price or weigh it — ModulesValue, UnladenMass, MaxJumpRange and Rebuy are all omitted."
      },
      {
        "slot": "FutureMount",
        "item": "int_something_we_have_never_seen",
        "verdict": "unknown",
        "why": "Neither the article nor the slot family is known, so the library refuses to call it free and weightless."
      }
    ]
  },
  "engineeringWithoutModifiers": {
    "note": "SLEF requires only Ship, Modules, Slot and Item; the specification's own example carries an Engineering block with BlueprintName, Level, Quality and ExperimentalEffect but NO Modifiers array. A parser that requires Modifiers cannot read the format it implements. Absent means 'not stated', not 'changed nothing': the module performs at its catalogue stats, modifier lookups return null, and an export must not invent an empty array on the way back out. Source: https://inara.cz/elite/inara-impexp-slef/",
    "modifiersRequired": false,
    "exportInventsEmptyArray": false
  },
  "journalFieldExclusions": {
    "note": "Fields a real journal capture may carry but the durable build deliberately does not. timestamp identifies the capture; ShipID identifies that journal's ship instance; HullHealth and Hot are transient ship state. Engineer and EngineerID record who applied engineering, and BlueprintID is redundant with BlueprintName. A journal -> ShipLoadout -> SLEF round trip drops these fields while retaining the engineering recipe, grade, quality, experimental effect and modifiers.",
    "topLevelBuild": "fixtures/ships/journal-viper-mkiv.jsonc",
    "topLevel": ["timestamp", "ShipID", "HullHealth", "Hot"],
    "engineeringBuild": "fixtures/ships/journal-krait-phantom.jsonc",
    "engineering": ["Engineer", "EngineerID", "BlueprintID"]
  },
  "deepBlack": {
    "build": "fixtures/ships/slef-the-deep-black.jsonc",
