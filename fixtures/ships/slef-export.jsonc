/*
 * Shared test fixture — not shipped in any package.
 *
 * Expected ShipLoadout import and export behavior for journal `Loadout` events and SLEF builds.
 * Pins the decisions rather than whole blobs: import normalization, which top-level keys an export
 * emits and leaves out, module order, and lower-cased journal casing. This is the DEFAULT
 * export: every top-level figure is recomputed from the hull and the fitted modules, never echoed
 * from the import. Credits are quoted at RETAIL — the bare hull's `hullCost` plus every module's
 * catalogue list price — so they deliberately differ from what a source build reports, since that
 * records one commander's purchase at one station. Each build's `discount` section pins the ratio,
 * which is how the retail figures are shown to be right; `fixtures/ships/source-purchase.jsonc`
 * pins the same source totals and the opt-in export that quotes them. Cross-language validation.
 */
{
  "rebuyFraction": 0.05,
  "classification": {
    "note": "How an entry in `Modules` is imported. The catalogue has the FIRST say: an article it can identify is retained whatever its slot is called. Known cosmetic/hull families are explicitly non-outfitting and are also retained. Every other entry is stripped, except unknown fixed mounts — armour, core internals and the cargo hatch — which are replaced by that hull's stock modules. Missing fixed mounts are filled from the same defaults. Numbered decals, bobbles and nameplates remain open-ended inside their established families.",
    "outfittingSlotPatterns": [
      "^powerplant$",
      "^mainengines$",
      "^frameshiftdrive$",
      "^lifesupport$",
      "^powerdistributor$",
      "^radar$",
      "^fueltank$",
      "^armour$",
      "^cargohatch$",
      "^planetaryapproachsuite$",
      "^(small|medium|large|huge)(mining)?hardpoint\\d+$",
      "^tinyhardpoint\\d+$",
      "^military\\d+$",
      "^cargo\\d+$",
      "^limpetcontroller\\d+$",
      "^fighterbay\\d+$",
      "^passenger\\d+$",
      "^slot\\d+_size\\d+$"
    ],
    "nonOutfittingSlotPattern": "^(paintjob|shipname\\d+|shipid\\d+|bobble\\d+|decal\\d+|shipkit.+|weaponcolour|enginecolour|vesselvoice|shipcockpit|stringlights)$",
    "patternsMatchLowerCasedSlot": true,
    "examples": [
      {
        "slot": "FutureCoreSlot",
        "item": "int_hyperdrive_size5_class5",
        "verdict": "outfitting",
        "why": "The catalogue knows the article; an unfamiliar slot name does not make it free."
      },
      {
        "slot": "frameshiftdrive",
        "item": "int_hyperdrive_size5_class5",
        "verdict": "outfitting",
        "why": "Lower-cased slot keys are what the SLEF specification's own example uses."
      },
      {
        "slot": "Bobble10",
        "item": "bobble_christmastree",
        "verdict": "nonOutfitting",
        "why": "The open-ended bobble family is explicitly non-outfitting, without this numbered slot appearing in a capture."
      },
      {
        "slot": "Slot99_Size4",
        "item": "int_something_we_have_never_seen",
        "verdict": "stripped",
        "why": "The catalogue cannot resolve the item, so it is removed during import."
      },
      {
        "slot": "FutureMount",
        "item": "int_something_we_have_never_seen",
        "verdict": "stripped",
        "why": "Neither the article nor the slot family is known, so the entry is removed during import."
      }
    ]
  },
