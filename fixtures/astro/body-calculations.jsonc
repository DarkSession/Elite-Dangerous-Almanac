/*
 * Shared test fixture — not shipped in any package.
 *
 * Ground truth for the body calculations ported from canonn-signals: bulk properties,
 * orbits and rotation, rings, and stars. Each case carries its inputs as journal `Scan`
 * fields — the same shape `BodyProperties` describes — so every language implementation
 * feeds identical numbers into identical formulas.
 *
 * Units are the journal's throughout: metres, seconds, kilograms, kelvin, Earth masses
 * (`MassEM`) for a planet and solar masses (`StellarMass`) for a star. A ring's surface
 * density is megatonnes per square kilometre, in the journal's own `MassMT`. Angles are
 * degrees.
 *
 * The bodies are the real Solar System ones where a familiar figure makes an error
 * obvious, and constructed otherwise. Their field values are physical measurements, not
 * game data: the fixture pins the *arithmetic*, so what matters is that every
 * implementation reads the same inputs, not that the game reports these exact bodies.
 * Expected values are computed from the stated formulas with the constants the library
 * documents (G = 6.6743e-11, 5.972e24 kg per Earth mass, 1.989e30 kg per solar mass) and
 * are rounded to 12 significant figures, so compare with a small relative tolerance.
 */
{
  "bulkDensity": [
    {
      "case": "Earth",
      "body": { "MassEM": 1, "Radius": 6371000 },
      "kgPerCubicMetre": 5513.25873859
    },
    {
      "case": "the Moon",
      "body": { "MassEM": 0.0123, "Radius": 1737400 },
      "kgPerCubicMetre": 3343.77348511
    },
    {
      "case": "the Sun, from its stellar mass",
      "body": { "StellarMass": 1, "Radius": 695700000 },
      "kgPerCubicMetre": 1410.19822516
    },
    {
      "case": "no radius written",
      "body": { "MassEM": 1 },
      "kgPerCubicMetre": null
    },
    {
      "case": "no mass written",
      "body": { "Radius": 6371000 },
      "kgPerCubicMetre": null
    },
    {
      "case": "a zero radius is not a body",
      "body": { "MassEM": 1, "Radius": 0 },
      "kgPerCubicMetre": null
    }
  ],
  "orbitExtents": [
    {
      "case": "Earth about the Sun",
      "body": { "SemiMajorAxis": 149600000000, "Eccentricity": 0.0167 },
      "periapsis": 147101680000,
      "apoapsis": 152098320000,
      "eccentricityClass": "nearly-circular"
    },
    {
      "case": "the Moon about Earth",
      "body": { "SemiMajorAxis": 384400000, "Eccentricity": 0.0549 },
      "periapsis": 363296440,
      "apoapsis": 405503560,
      "eccentricityClass": "nearly-circular"
    },
    {
      "case": "no eccentricity written is a circle",
      "body": { "SemiMajorAxis": 1000000000 },
      "periapsis": 1000000000,
      "apoapsis": 1000000000,
      "eccentricityClass": "circular"
    },
    {
      "case": "a long ellipse",
      "body": { "SemiMajorAxis": 1000000000, "Eccentricity": 0.9 },
      "periapsis": 100000000,
      "apoapsis": 1900000000,
      "eccentricityClass": "highly-eccentric"
    },
    {
      "case": "a body that orbits nothing",
      "body": { "StellarMass": 1 },
      "periapsis": null,
      "apoapsis": null,
      "eccentricityClass": null
    }
  ],
  "eccentricityClass": [
    { "eccentricity": 0, "class": "circular" },
    { "eccentricity": 0.0549, "class": "nearly-circular" },
    { "eccentricity": 0.399999, "class": "nearly-circular" },
    { "eccentricity": 0.4, "class": "eccentric" },
    { "eccentricity": 0.799999, "class": "eccentric" },
    { "eccentricity": 0.8, "class": "highly-eccentric" },
    { "eccentricity": 0.99, "class": "highly-eccentric" }
  ],
