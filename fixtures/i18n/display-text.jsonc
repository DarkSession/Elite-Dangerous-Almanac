    {
      "variant": {
        "symbol": "Hpt_Railgun_Fixed_Medium",
        "blueprint": "Weapon_HighCapacity",
        "experimental": "special_super_penetrator",
        "acquisition": "communityGoal"
      },
      "locale": "en",
      "expected": null
    }
  ],
  "slots": [
    {
      "slot": {
        "kind": "core",
        "key": "PowerPlant",
        "size": 2,
        "core": "powerPlant"
      },
      "locale": "en",
      "expected": "Power Plant"
    },
    {
      "slot": {
        "kind": "hardpoint",
        "key": "LargeMiningHardpoint2",
