        "restriction": "mining"
      },
      "locale": "en-AU",
      "expected": "Large Mining Hardpoint 2"
    },
    {
      "slot": {
        "kind": "utility",
        "key": "TinyHardpoint1",
        "size": 0
      },
      "locale": "fr",
      "expected": null
    },
    {
      "slot": {
        "kind": "optional",
        "key": "Slot01_Size4",
        "size": 4
