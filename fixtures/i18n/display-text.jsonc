      "locale": "en",
      "expected": "Optional Internal 1 (Size 4)"
    },
    {
      "slot": {
        "kind": "armour",
        "key": "Armour",
        "size": 0
      },
      "locale": "en",
      "expected": "Armour"
    },
    {
      "slot": {
        "kind": "cargoHatch",
        "key": "CargoHatch",
        "size": 1
      },
      "locale": "en",
      "expected": "Cargo Hatch"
    }
  ],
  "restrictions": [
    {
      "restriction": "mining",
      "locale": "en-GB",
      "expected": "mining tools"
    },
    {
      "restriction": "passenger",
      "locale": "de",
      "expected": null
    }
  ],
  "diagnostics": [
    {
      "kind": "loadout",
      "diagnostic": {
        "code": "missingRequiredSlot",
        "severity": "incomplete",
        "message": "PowerPlant is required for an operational build"
      },
      "locale": "en",
      "expected": "PowerPlant is required for an operational build"
    },
    {
      "kind": "calculation",
      "diagnostic": {
        "field": "mass",
        "message": "Mass unavailable"
      },
      "locale": "en-GB",
      "expected": "Mass unavailable"
    },
    {
      "kind": "slef",
      "diagnostic": {
        "index": 0,
        "code": "invalidLoadout",
        "path": "[0].Ship",
        "constraint": "stringRequired",
        "message": "Ship is required"
      },
      "locale": "fr",
      "expected": null
