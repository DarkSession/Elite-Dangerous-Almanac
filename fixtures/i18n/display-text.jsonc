        "blueprint": "AbrasionBlaster_FarReaching",
        "acquisition": "mercenary"
      },
      "locale": "de-DE",
      "expected": "Abrasionsblaster mit großer Reichweite"
    },
    {
      "variant": {
        "symbol": "Hpt_FlakMortar_Turret_Medium",
